# Google Calendar scheduling — copy to .env.local and fill in.
# See docs/google-calendar-setup.md for how to obtain these.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Set to "true" only while running the one-time /api/auth/google flow.
# Leave unset (or "false") in normal operation.
ENABLE_AUTH_SETUP=false
